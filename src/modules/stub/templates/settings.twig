{% import '_includes/forms' as forms %}

<h2>{{ 'General'|t('stub') }}</h2>

{{ forms.textField({
    label: 'Plugin Name'|t('stub'),
    instructions: 'The name to display in the CP sidebar.'|t('stub'),
    id: 'pluginName',
    name: 'pluginName',
    value: settings.pluginName,
    errors: settings.getErrors('pluginName'),
}) }}

{{ forms.selectField({
    label: 'Default Currency'|t('stub'),
    id: 'defaultCurrency',
    name: 'defaultCurrency',
    value: settings.defaultCurrency,
    options: [
        { label: 'USD', value: 'USD' },
        { label: 'EUR', value: 'EUR' },
        { label: 'GBP', value: 'GBP' },
        { label: 'CAD', value: 'CAD' },
        { label: 'AUD', value: 'AUD' },
    ],
    errors: settings.getErrors('defaultCurrency'),
}) }}

{{ forms.selectField({
    label: 'Default Timezone'|t('stub'),
    id: 'defaultTimezone',
    name: 'defaultTimezone',
    value: settings.defaultTimezone,
    options: craft.app.i18n.allLocales|map(l => { label: l.displayName, value: l.id })|merge(
        craft.app.timeZone ? [{ label: craft.app.timeZone, value: craft.app.timeZone }] : []
    ),
    errors: settings.getErrors('defaultTimezone'),
}) }}

{{ forms.textField({
    label: 'Minimum Notice (minutes)'|t('stub'),
    instructions: 'How far in advance a booking must be made.'|t('stub'),
    id: 'minimumNotice',
    name: 'minimumNotice',
    value: settings.minimumNotice,
    type: 'number',
    min: 0,
    errors: settings.getErrors('minimumNotice'),
}) }}

{{ forms.textField({
    label: 'Max Advance Booking (days)'|t('stub'),
    instructions: 'How far in the future bookings can be made.'|t('stub'),
    id: 'maxAdvanceBooking',
    name: 'maxAdvanceBooking',
    value: settings.maxAdvanceBooking,
    type: 'number',
    min: 1,
    errors: settings.getErrors('maxAdvanceBooking'),
}) }}

{{ forms.textField({
    label: 'Slot Interval (minutes)'|t('stub'),
    instructions: 'Time between available slot start times.'|t('stub'),
    id: 'slotInterval',
    name: 'slotInterval',
    value: settings.slotInterval,
    type: 'number',
    min: 5,
    errors: settings.getErrors('slotInterval'),
}) }}

<hr>
<h2>{{ 'Booking Options'|t('stub') }}</h2>

{{ forms.lightswitchField({
    label: 'Auto-Confirm Free Bookings'|t('stub'),
    id: 'autoConfirmFreeBookings',
    name: 'autoConfirmFreeBookings',
    on: settings.autoConfirmFreeBookings,
}) }}

{{ forms.lightswitchField({
    label: 'Require Phone Number'|t('stub'),
    id: 'requirePhone',
    name: 'requirePhone',
    on: settings.requirePhone,
}) }}

{{ forms.lightswitchField({
    label: 'Allow Customer Notes'|t('stub'),
    id: 'allowCustomerNotes',
    name: 'allowCustomerNotes',
    on: settings.allowCustomerNotes,
}) }}

{{ forms.lightswitchField({
    label: 'Link Customers to Users'|t('stub'),
    instructions: 'Attach a customer record to the Craft user with the same email address, so a member who books as a guest is still recognised. Turn off if a shared address shouldn’t imply one person.'|t('stub'),
    id: 'linkCustomersToUsers',
    name: 'linkCustomersToUsers',
    on: settings.linkCustomersToUsers,
}) }}

{{ forms.textField({
    label: 'Reference Prefix'|t('stub'),
    instructions: 'Prefix for booking reference numbers (e.g. STB).'|t('stub'),
    id: 'referencePrefix',
    name: 'referencePrefix',
    value: settings.referencePrefix,
}) }}

{{ forms.textField({
    label: 'Booking Page URL'|t('stub'),
    instructions: 'The URL where the booking form is embedded (for email links).'|t('stub'),
    id: 'bookingPageUrl',
    name: 'bookingPageUrl',
    value: settings.bookingPageUrl,
}) }}

{{ forms.textField({
    label: 'Terms & Conditions URL'|t('stub'),
    id: 'termsUrl',
    name: 'termsUrl',
    value: settings.termsUrl,
}) }}

