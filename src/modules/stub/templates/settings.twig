<h2>{{ 'Stripe Payments'|t('stub') }}</h2>

{{ forms.lightswitchField({
    label: 'Enable Payments'|t('stub'),
    id: 'paymentEnabled',
    name: 'paymentEnabled',
    on: settings.paymentEnabled,
}) }}

{{ forms.autosuggestField({
    label: 'Stripe Publishable Key'|t('stub'),
    instructions: 'Supports $ENV_VAR syntax.'|t('stub'),
    id: 'stripePublishableKey',
    name: 'stripePublishableKey',
    value: settings.stripePublishableKey,
    suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
    label: 'Stripe Secret Key'|t('stub'),
