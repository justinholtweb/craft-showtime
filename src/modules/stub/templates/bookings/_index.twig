{# Craft's `_elements/indexcontainer` is deprecated and ships no JS init, so extend
   `_layouts/elementindex`, which wires up Craft.createElementIndex, the sources
   sidebar, and the toolbar for us. #}
{% extends '_layouts/elementindex' %}

{% set elementType = 'justinholtweb\\stub\\elements\\Booking' %}

{% set title = 'Bookings'|t('stub') %}
{% set selectedSubnavItem = 'bookings' %}
{% set context = 'index' %}
{% set canHaveDrafts = false %}
{% set showSiteMenu = false %}
{% set elementDisplayName = 'Booking'|t('stub') %}
{% set elementPluralDisplayName = 'Bookings'|t('stub') %}
{% set sources = craft.app.elementSources.getSources(elementType, context) %}

{# Viewing bookings and creating one are separate permissions, so the button only shows
   for someone who could actually save the form it leads to. #}
{% block actionButton %}
    {% if currentUser.can('stub:manageBookings') %}
        <a href="{{ cpUrl('stub/bookings/new') }}" class="btn submit add icon">{{ 'New Booking'|t('stub') }}</a>
    {% endif %}
{% endblock %}
