{% extends 'stub/_layouts/cp' %}

{% set title = booking.referenceNumber %}
{% set selectedSubnavItem = 'bookings' %}

{% block content %}
    {% import '_includes/forms' as forms %}

    <div class="grid" style="--cols: 2; gap: 24px; display: grid; grid-template-columns: 2fr 1fr;">
        <div>
            <div class="pane">
                <h2>{{ 'Booking Details'|t('stub') }}</h2>

                <table class="data fullwidth">
                    <tbody>
                        <tr>
                            <th>{{ 'Reference'|t('stub') }}</th>
                            <td><code>{{ booking.referenceNumber }}</code></td>
                        </tr>
                        <tr>
                            <th>{{ 'Service'|t('stub') }}</th>
                            <td>{{ service ? service.name : '—' }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'Provider'|t('stub') }}</th>
                            <td>{{ provider ? provider.name : '—' }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'Date & Time'|t('stub') }}</th>
                            <td>
                                {% if booking.localStartDateTime %}
                                    {{ booking.localStartDateTime|date('M j, Y g:i A', timezone=booking.timezone) }}
                                    ({{ booking.timezone }})
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'Price'|t('stub') }}</th>
                            <td>{{ craft.stub.formatPrice(booking.price, booking.currency) }}</td>
                        </tr>
                        {% if booking.price > 0 %}
                            <tr>
                                <th>{{ 'Payment Mode'|t('stub') }}</th>
                                <td>{{ booking.paymentModeEnum.label()|t('stub') }}</td>
                            </tr>
                            {% if booking.paymentMode == 'deposit' %}
                                <tr>
                                    <th>{{ 'Deposit'|t('stub') }}</th>
                                    <td>{{ craft.stub.formatPrice(booking.depositAmount, booking.currency) }}</td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th>{{ 'Paid'|t('stub') }}</th>
                                <td>{{ craft.stub.formatPrice(booking.amountPaid, booking.currency) }}</td>
                            </tr>
                            <tr>
                                <th>{{ 'Balance Due'|t('stub') }}</th>
                                <td><strong>{{ craft.stub.formatPrice(booking.balanceDue, booking.currency) }}</strong></td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th>{{ 'Payment Status'|t('stub') }}</th>
                            <td>
                                {% set paymentStatus = booking.paymentStatusEnum %}
                                <span class="status {{ paymentStatus.color() }}"></span>
                                {{ paymentStatus.label()|t('stub') }}
                            </td>
                        </tr>
                        {% if booking.stripePaymentIntentId %}
                            <tr>
                                <th>{{ 'Stripe Payment Intent'|t('stub') }}</th>
                                <td><code>{{ booking.stripePaymentIntentId }}</code></td>
                            </tr>
                        {% endif %}
                        {% if booking.customerNotes %}
                            <tr>
                                <th>{{ 'Customer Notes'|t('stub') }}</th>
                                <td>{{ booking.customerNotes }}</td>
                            </tr>
                        {% endif %}
                        {% if booking.cancellationReason %}
                            <tr>
                                <th>{{ 'Cancellation Reason'|t('stub') }}</th>
                                <td>{{ booking.cancellationReason }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th>{{ 'Reminder'|t('stub') }}</th>
                            <td>
                                {% if booking.reminderSentAt %}
                                    {{ 'Sent {date}'|t('stub', {
                                        date: booking.localReminderSentAt|date('M j, Y g:i A', timezone=booking.timezone) ~ ' (' ~ booking.timezone ~ ')',
                                    }) }}
                                {% else %}
                                    {{ 'Not sent'|t('stub') }}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'Created'|t('stub') }}</th>
                            <td>{{ booking.dateCreated|date('M j, Y g:i A') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {% if customer %}
                <div class="pane" style="margin-top: 24px;">
                    <h2>{{ 'Customer'|t('stub') }}</h2>
                    <table class="data fullwidth">
                        <tbody>
                            <tr><th>{{ 'Name'|t('stub') }}</th><td>{{ customer.firstName }} {{ customer.lastName }}</td></tr>
                            <tr><th>{{ 'Email'|t('stub') }}</th><td><a href="mailto:{{ customer.email }}">{{ customer.email }}</a></td></tr>
                            {% if customer.phone %}<tr><th>{{ 'Phone'|t('stub') }}</th><td>{{ customer.phone }}</td></tr>{% endif %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div>
            <div class="pane">
                <h2>{{ 'Status'|t('stub') }}</h2>
                <form method="post">
                    {{ csrfInput() }}
                    {{ actionInput('stub/bookings/update-status') }}
                    {{ hiddenInput('bookingId', booking.id) }}

                    {{ forms.selectField({
                        label: 'Booking Status'|t('stub'),
                        name: 'bookingStatus',
                        value: booking.bookingStatus,
                        options: statuses|map(s => { label: s.label(), value: s.value }),
                    }) }}

                    <div id="cancellation-reason" style="{{ booking.bookingStatus != 'cancelled' ? 'display:none' }}">
                        {{ forms.textareaField({
                            label: 'Cancellation Reason'|t('stub'),
                            name: 'cancellationReason',
                            value: booking.cancellationReason,
                            rows: 2,
                        }) }}
                    </div>

                    {{ forms.textareaField({
                        label: 'Admin Notes'|t('stub'),
                        name: 'adminNotes',
                        value: booking.adminNotes,
                        rows: 3,
                    }) }}

                    <button type="submit" class="btn submit">{{ 'Update'|t('stub') }}</button>
                </form>
            </div>
            {% if booking.price > 0 %}
                <div class="pane" style="margin-top: 24px;">
                    <h2>{{ 'Payment'|t('stub') }}</h2>

                    {% if booking.balanceDue > 0 and booking.paymentStatus != 'refunded' and currentUser.can('stub:recordPayments') %}
                        <form method="post">
                            {{ csrfInput() }}
                            {{ actionInput('stub/bookings/mark-paid') }}
                            {{ hiddenInput('bookingId', booking.id) }}

                            {{ forms.textField({
                                label: 'Amount Received'|t('stub'),
                                instructions: 'Leave as the balance to mark the booking paid in full.'|t('stub'),
                                id: 'amount',
                                name: 'amount',
                                value: booking.balanceDue,
                                type: 'number',
                                step: 'any',
                                min: 0,
                                max: booking.balanceDue,
                            }) }}

                            {{ forms.textField({
                                label: 'Note'|t('stub'),
                                instructions: 'How it was paid — cash, card at the desk.'|t('stub'),
                                id: 'note',
                                name: 'note',
                                maxlength: 255,
                            }) }}

                            <button type="submit" class="btn submit">{{ 'Mark as Paid'|t('stub') }}</button>
                        </form>
                    {% elseif booking.balanceDue <= 0 %}
                        <p class="light">{{ 'Nothing is owed on this booking.'|t('stub') }}</p>
                    {% endif %}

                    {% if payments|length %}
                        <h3 style="margin-top: 16px;">{{ 'Payments'|t('stub') }}</h3>
                        <table class="data fullwidth">
                            <tbody>
                                {% for payment in payments %}
                                    <tr>
                                        <td>
                                            {{ craft.stub.formatPrice(payment.amount, payment.currency) }}
                                            <div class="light smalltext">
                                                {{ payment.method == 'manual' ? 'Recorded'|t('stub') : 'Stripe'|t('stub') }}
                                                {%- if payment.status != 'succeeded' %} · {{ payment.status|t('stub') }}{% endif %}
                                                {%- if payment.note %} · {{ payment.note }}{% endif %}
                                            </div>
                                        </td>
                                        <td class="rightalign light smalltext">
                                            {% set when = payment.paidAt ?? payment.dateCreated %}
                                            {{ when ? (when ~ ' UTC')|date('M j, Y g:i A') : '' }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            {% endif %}

            <div class="pane" style="margin-top: 24px;">
                <h2>{{ 'Reminder'|t('stub') }}</h2>

                {% if remindersEnabled and currentUser.can('stub:manageBookings') %}
                    <p class="light">
                        {{ 'Reminders normally go out {hours} hours before the appointment, from the scheduled stub/reminders/send command. Send this one now instead:'|t('stub', { hours: settings.reminderLeadTime }) }}
                    </p>

                    <form method="post">
                        {{ csrfInput() }}
                        {{ actionInput('stub/bookings/send-reminder') }}
                        {{ hiddenInput('bookingId', booking.id) }}

                        <button type="submit" class="btn">
                            {{ booking.reminderSentAt ? 'Send Reminder Again'|t('stub') : 'Send Reminder Now'|t('stub') }}
                        </button>
                    </form>
                {% elseif not remindersEnabled %}
                    <p class="light">
                        {{ 'Reminder emails are turned off.'|t('stub') }}
                        <a href="{{ cpUrl('settings/plugins/stub') }}">{{ 'Plugin settings'|t('stub') }}</a>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>

    {% js %}
        $('[name="bookingStatus"]').on('change', function() {
            if ($(this).val() === 'cancelled') {
                $('#cancellation-reason').show();
            } else {
                $('#cancellation-reason').hide();
            }
        });
    {% endjs %}
{% endblock %}
