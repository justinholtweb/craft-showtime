<h3>{{ 'Select a Service'|t('stub') }}</h3>

<div class="stub-service-list">
    {% for service in services %}
        <div class="stub-service-card"
             data-id="{{ service.id }}"
             data-name="{{ service.name }}"
             data-duration="{{ service.duration }}"
             data-price="{{ service.price }}"
             data-currency="{{ service.currency }}">
            <div class="stub-service-name">{{ service.name }}</div>
            <div class="stub-service-meta">
                <span>{{ service.duration }} min</span>
                <span>{{ service.price > 0 ? craft.stub.formatPrice(service.price, service.currency) : 'Free'|t('stub') }}</span>
                {% if service.price > 0 and service.paymentMode == 'deposit' %}
                    <span class="stub-service-payment">{{ '{amount} deposit to book'|t('stub', { amount: craft.stub.formatPrice(service.depositFor(service.price), service.currency) }) }}</span>
                {% elseif service.price > 0 and service.paymentMode == 'inPerson' %}
                    <span class="stub-service-payment">{{ 'Pay in person'|t('stub') }}</span>
                {% endif %}
            </div>
            {% if service.description %}
                <div class="stub-service-desc">{{ service.description }}</div>
            {% endif %}
        </div>
    {% else %}
        {# A filtered form can legitimately come up empty — an author with no services yet,
           or a `{ user: currentUser }` filter on a logged-out request. Say so rather than
           rendering an empty box with a progress bar above it. #}
        <p class="stub-empty">{{ 'No services are available to book right now.'|t('stub') }}</p>
    {% endfor %}
</div>
