{% extends 'stub/_layouts/cp' %}

{% set title = 'Services'|t('stub') %}
{% set selectedSubnavItem = 'services' %}

{% block content %}
    <div class="toolbar">
        <a href="{{ cpUrl('stub/services/new') }}" class="btn submit">{{ 'New Service'|t('stub') }}</a>
    </div>

    {% if services|length %}
        <div class="tableview">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Name'|t('stub') }}</th>
                        <th>{{ 'Handle'|t('stub') }}</th>
                        <th>{{ 'Duration'|t('stub') }}</th>
                        <th>{{ 'Price'|t('stub') }}</th>
                        <th>{{ 'Capacity'|t('stub') }}</th>
                        <th>{{ 'Status'|t('stub') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="services-table">
                    {% for service in services %}
                        <tr data-id="{{ service.id }}">
                            <td>
                                <span class="status {{ service.enabled ? 'enabled' : 'disabled' }}" style="background-color: {{ service.color }}"></span>
                                <a href="{{ cpUrl('stub/services/' ~ service.id) }}">{{ service.name }}</a>
                            </td>
                            <td><code>{{ service.handle }}</code></td>
                            <td>{{ service.duration }} min</td>
                            <td>{{ service.price > 0 ? (service.price|number_format(2) ~ ' ' ~ service.currency) : 'Free'|t('stub') }}</td>
                            <td>{{ service.capacity }}</td>
                            <td>
                                <span class="status {{ service.enabled ? 'enabled' : 'disabled' }}"></span>
                                {{ service.enabled ? 'Enabled'|t('stub') : 'Disabled'|t('stub') }}
                            </td>
                            <td class="thin">
                                <a class="delete icon" title="{{ 'Delete'|t('app') }}" role="button" data-id="{{ service.id }}"></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ 'No services yet.'|t('stub') }} <a href="{{ cpUrl('stub/services/new') }}">{{ 'Create one'|t('stub') }}</a></p>
    {% endif %}

    {% js %}
        (function() {
            var $table = $('#services-table');

            $table.find('.delete').on('click', function(e) {
                e.preventDefault();
                var $row = $(this).closest('tr');
                var id = $(this).data('id');

                if (confirm('{{ "Are you sure you want to delete this service?"|t("stub") }}')) {
                    Craft.sendActionRequest('POST', 'stub/services/delete', {
                        data: { id: id }
                    }).then(function() {
                        $row.remove();
                        Craft.cp.displayNotice('{{ "Service deleted."|t("stub") }}');
                    });
                }
            });
        })();
    {% endjs %}
{% endblock %}
