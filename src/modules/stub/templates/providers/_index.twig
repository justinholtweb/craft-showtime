{% extends 'stub/_layouts/cp' %}

{% set title = 'Providers'|t('stub') %}
{% set selectedSubnavItem = 'providers' %}

{% block content %}
    <div class="toolbar">
        <a href="{{ cpUrl('stub/providers/new') }}" class="btn submit">{{ 'New Provider'|t('stub') }}</a>
    </div>

    {% if providers|length %}
        <div class="tableview">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Name'|t('stub') }}</th>
                        <th>{{ 'Handle'|t('stub') }}</th>
                        <th>{{ 'Email'|t('stub') }}</th>
                        <th>{{ 'Timezone'|t('stub') }}</th>
                        <th>{{ 'Status'|t('stub') }}</th>
                        <th>{{ 'Schedule'|t('stub') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for provider in providers %}
                        <tr data-id="{{ provider.id }}">
                            <td>
                                <span class="status {{ provider.enabled ? 'enabled' : 'disabled' }}" style="background-color: {{ provider.color }}"></span>
                                <a href="{{ cpUrl('stub/providers/' ~ provider.id) }}">{{ provider.name }}</a>
                            </td>
                            <td><code>{{ provider.handle }}</code></td>
                            <td>{{ provider.email }}</td>
                            <td>{{ provider.timezone }}</td>
                            <td>
                                <span class="status {{ provider.enabled ? 'enabled' : 'disabled' }}"></span>
                                {{ provider.enabled ? 'Enabled'|t('stub') : 'Disabled'|t('stub') }}
                            </td>
                            <td>
                                <a href="{{ cpUrl('stub/providers/' ~ provider.id ~ '/schedule') }}" class="btn small">{{ 'Edit Schedule'|t('stub') }}</a>
                            </td>
                            <td class="thin">
                                <a class="delete icon" title="{{ 'Delete'|t('app') }}" role="button" data-id="{{ provider.id }}"></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ 'No providers yet.'|t('stub') }} <a href="{{ cpUrl('stub/providers/new') }}">{{ 'Create one'|t('stub') }}</a></p>
    {% endif %}

    {% js %}
        (function() {
            $('table').find('.delete').on('click', function(e) {
                e.preventDefault();
                var $row = $(this).closest('tr');
                var id = $(this).data('id');

                if (confirm('{{ "Are you sure you want to delete this provider?"|t("stub") }}')) {
                    Craft.sendActionRequest('POST', 'stub/providers/delete', {
                        data: { id: id }
                    }).then(function() {
                        $row.remove();
                        Craft.cp.displayNotice('{{ "Provider deleted."|t("stub") }}');
                    });
                }
            });
        })();
    {% endjs %}
{% endblock %}
