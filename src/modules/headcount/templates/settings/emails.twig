{% extends '_layouts/cp' %}

{% set title = 'Emails'|t('headcount') %}
{% set selectedSubnavItem = 'settings' %}
{#
  Read-only when `allowAdminChanges` is off. The save action already refuses in that case
  (SettingsController::beforeAction), so this is about not offering an edit that will be
  rejected: no form, no save button, disabled inputs, and Craft's standard notice saying why.
#}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include 'headcount/settings/_sidebar' with { selected: 'emails' } only %}
{% endblock %}

{% block content %}
    {% if not readOnly %}
        <input type="hidden" name="action" value="headcount/settings/save">
        {{ csrfInput() }}
    {% endif %}

    <p>{{ 'Headcount uses Craft’s built-in mailer. Configure your transport under Settings → Email, and edit the copy of each message under Settings → Email → System Messages.'|t('headcount') }}</p>

    <hr>

    {% include 'headcount/settings/_emails' %}
{% endblock %}
