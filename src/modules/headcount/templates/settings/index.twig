<h2>{{ 'API & Webhooks'|t('headcount') }}</h2>

{{ forms.autosuggestField({
    label: 'API Key'|t('headcount'),
    instructions: 'API key for server-to-server authentication.'|t('headcount'),
    name: 'apiKey',
    suggestEnvVars: true,
    value: settings.apiKey,
}) }}

{{ forms.textField({
    label: 'Outgoing Webhook URL'|t('headcount'),
