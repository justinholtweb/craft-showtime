}) }}

{{ forms.autosuggestField({
    label: 'PayPal Client Secret'|t('headcount'),
    name: 'paypalClientSecret',
    suggestEnvVars: true,
    value: settings.paypalClientSecret,
}) }}

{{ forms.autosuggestField({
    label: 'PayPal Webhook ID'|t('headcount'),
    name: 'paypalWebhookId',
    suggestEnvVars: true,
    value: settings.paypalWebhookId,
}) }}

<hr>

<h2>{{ 'Emails'|t('headcount') }}</h2>

{{ forms.lightswitchField({ label: 'Send Welcome Email'|t('headcount'), name: 'sendWelcomeEmail', on: settings.sendWelcomeEmail }) }}
{{ forms.lightswitchField({ label: 'Send Payment Receipt Email'|t('headcount'), name: 'sendPaymentReceiptEmail', on: settings.sendPaymentReceiptEmail }) }}
{{ forms.lightswitchField({ label: 'Send Payment Failed Email'|t('headcount'), name: 'sendPaymentFailedEmail', on: settings.sendPaymentFailedEmail }) }}
{{ forms.lightswitchField({ label: 'Send Expiration Reminder Email'|t('headcount'), name: 'sendExpirationReminderEmail', on: settings.sendExpirationReminderEmail }) }}
{{ forms.lightswitchField({ label: 'Send Trial Ending Email'|t('headcount'), name: 'sendTrialEndingEmail', on: settings.sendTrialEndingEmail }) }}
{{ forms.lightswitchField({ label: 'Send Cancellation Email'|t('headcount'), name: 'sendCancellationEmail', on: settings.sendCancellationEmail }) }}
{{ forms.lightswitchField({ label: 'Send Drip Unlocked Email'|t('headcount'), name: 'sendDripUnlockedEmail', on: settings.sendDripUnlockedEmail }) }}

{{ forms.textField({
    label: 'Expiration Reminder Days'|t('headcount'),
    instructions: 'Days before expiration to send reminder.'|t('headcount'),
    name: 'expirationReminderDays',
    value: settings.expirationReminderDays,
    type: 'number',
    min: 1,
    size: 5,
}) }}

