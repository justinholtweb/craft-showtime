{% extends '_layouts/cp' %}

{% set title = 'Stripe'|t('headcount') %}
{% set selectedSubnavItem = 'settings' %}
{#
  Read-only when `allowAdminChanges` is off. The save action already refuses in that case
  (SettingsController::beforeAction), so this is about not offering an edit that will be
  rejected: no form, no save button, disabled inputs, and Craft's standard notice saying why.
#}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include 'headcount/settings/_sidebar' with { selected: 'stripe' } only %}
{% endblock %}

{% block content %}
    {% if not readOnly %}
        <input type="hidden" name="action" value="headcount/settings/save">
        {{ csrfInput() }}
    {% endif %}

    {% include 'headcount/settings/_stripe' %}

    <hr>

    <h2>{{ 'Webhook Endpoint'|t('headcount') }}</h2>
    <p>{{ 'Configure your Stripe webhook to point to:'|t('headcount') }}</p>
    <p><code>{{ siteUrl('actions/headcount/webhook/stripe') }}</code></p>
    <p>{{ 'Events to listen for:'|t('headcount') }}</p>
    <ul>
        <li><code>checkout.session.completed</code></li>
        <li><code>customer.subscription.created</code></li>
        <li><code>customer.subscription.updated</code></li>
        <li><code>customer.subscription.deleted</code></li>
        <li><code>invoice.paid</code></li>
        <li><code>invoice.payment_failed</code></li>
        <li><code>invoice.payment_action_required</code></li>
        <li><code>customer.subscription.trial_will_end</code></li>
    </ul>
{% endblock %}
