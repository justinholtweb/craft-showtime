{% extends '_layouts/cp' %}

{% set title = 'Stripe'|t('headcount') %}
{% set selectedSubnavItem = 'settings' %}
{#
  Read-only when `allowAdminChanges` is off. The save action already refuses in that case
  (SettingsController::beforeAction), so this is about not offering an edit that will be
  rejected: no form, no save button, disabled inputs, and Craft's standard notice saying why.
#}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include 'headcount/settings/_sidebar' with { selected: 'stripe' } only %}
{% endblock %}

{% block content %}
    {% if not readOnly %}
        <input type="hidden" name="action" value="headcount/settings/save">
        {{ csrfInput() }}
    {% endif %}

    {% include 'headcount/settings/_stripe' %}

    <hr>

    <h2>{{ 'Webhook Endpoint'|t('headcount') }}</h2>
    <p>{{ 'Configure your Stripe webhook to point to:'|t('headcount') }}</p>
    <p><code>{{ siteUrl('actions/headcount/webhook/stripe') }}</code></p>
    <p>{{ 'Events to listen for:'|t('headcount') }}</p>
    <ul>
        <li><code>checkout.session.completed</code></li>
        <li><code>checkout.session.async_payment_succeeded</code></li>
        <li><code>customer.subscription.created</code></li>
        <li><code>customer.subscription.updated</code></li>
        <li><code>customer.subscription.deleted</code></li>
        <li><code>invoice.paid</code></li>
        <li><code>invoice.payment_failed</code></li>
        <li><code>invoice.payment_action_required</code></li>
        <li><code>customer.subscription.trial_will_end</code></li>
    </ul>

    {% if webhookHealth is defined %}
        <hr>

        <h2>{{ 'Webhook Status'|t('headcount') }}</h2>

        {% for problem in webhookProblems %}
            <p class="error">{{ problem|raw }}</p>
        {% endfor %}

        <table class="data fullwidth">
            <tbody>
                <tr>
                    <th>{{ 'Last webhook received'|t('headcount') }}</th>
                    <td>{{ webhookHealth.lastReceived ? webhookHealth.lastReceived|datetime('short') : 'Never'|t('headcount') }}</td>
                </tr>
                <tr>
                    <th>{{ 'Last webhook rejected'|t('headcount') }}</th>
                    <td>
                        {% if webhookHealth.lastRejected %}
                            {{ webhookHealth.lastRejected.time|datetime('short') }} — {{ webhookHealth.lastRejected.reason }}
                        {% else %}
                            {{ 'None'|t('headcount') }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>{{ 'Last signup recorded at checkout return'|t('headcount') }}</th>
                    <td>{{ webhookHealth.lastFallback ? webhookHealth.lastFallback|datetime('short') : 'None'|t('headcount') }}</td>
                </tr>
            </tbody>
        </table>

        <p class="light">{{ 'Stripe shows every delivery attempt and the response this site gave under Developers → Webhooks → your endpoint. Subscriptions Headcount missed can be pulled in with {command}.'|t('headcount', { command: '<code>php craft headcount/subscriptions/import</code>' })|raw }}</p>
    {% endif %}
{% endblock %}
