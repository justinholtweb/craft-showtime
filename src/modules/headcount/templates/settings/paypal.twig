{% extends '_layouts/cp' %}

{% set title = 'PayPal'|t('headcount') %}
{% set selectedSubnavItem = 'settings' %}
{#
  Read-only when `allowAdminChanges` is off. The save action already refuses in that case
  (SettingsController::beforeAction), so this is about not offering an edit that will be
  rejected: no form, no save button, disabled inputs, and Craft's standard notice saying why.
#}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include 'headcount/settings/_sidebar' with { selected: 'paypal' } only %}
{% endblock %}

{% block content %}
    {% if not readOnly %}
        <input type="hidden" name="action" value="headcount/settings/save">
        {{ csrfInput() }}
    {% endif %}

    {% include 'headcount/settings/_paypal' %}

    <hr>

    <h2>{{ 'Webhook Endpoint'|t('headcount') }}</h2>
    <p>{{ 'Configure your PayPal webhook to point to:'|t('headcount') }}</p>
    <p><code>{{ siteUrl('actions/headcount/webhook/paypal') }}</code></p>
    <p>{{ 'Events to listen for:'|t('headcount') }}</p>
    <ul>
        <li><code>BILLING.SUBSCRIPTION.ACTIVATED</code></li>
        <li><code>BILLING.SUBSCRIPTION.CANCELLED</code></li>
        <li><code>BILLING.SUBSCRIPTION.SUSPENDED</code></li>
        <li><code>BILLING.SUBSCRIPTION.EXPIRED</code></li>
        <li><code>PAYMENT.SALE.COMPLETED</code></li>
        <li><code>PAYMENT.SALE.DENIED</code></li>
    </ul>

    <p class="light">{{ 'PayPal cannot be used for season memberships — its Subscriptions API only bills on a cycle, so checkout refuses a PayPal season purchase rather than signing the member up to something recurring.'|t('headcount') }}</p>
{% endblock %}
