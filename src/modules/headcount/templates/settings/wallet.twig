{% extends '_layouts/cp' %}

{% set title = 'Wallet Cards'|t('headcount') %}
{% set selectedSubnavItem = 'settings' %}
{#
  Read-only when `allowAdminChanges` is off. The save action already refuses in that case
  (SettingsController::beforeAction), so this is about not offering an edit that will be
  rejected: no form, no save button, disabled inputs, and Craft's standard notice saying why.
#}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include 'headcount/settings/_sidebar' with { selected: 'wallet' } only %}
{% endblock %}

{% block content %}
    {% if not readOnly %}
        <input type="hidden" name="action" value="headcount/settings/save">
        {{ csrfInput() }}
    {% endif %}

    <p>
        {{ 'Members can add a membership card to Apple Wallet or Google Wallet and show it to prove membership away from the site. Both platforms bind a card to the organisation issuing it, so the credentials below are yours, not Headcount’s — you supply them from your own Apple Developer and Google Cloud accounts. Either platform can be used on its own.'|t('headcount') }}
    </p>

    <hr>

    {% include 'headcount/settings/_wallet' %}

    <hr>

    <h2>{{ 'Pass Web Service'|t('headcount') }}</h2>

    <p>{{ 'Apple devices talk back to this site at:'|t('headcount') }}</p>
    <p><code>{{ siteUrl('headcount/wallet/v1') }}</code></p>
    <p>{{ 'Nothing to configure — the URL is baked into each pass when it is issued. It must be reachable over HTTPS with a valid certificate, or devices will silently refuse to register.'|t('headcount') }}</p>
{% endblock %}
