{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = title %}
{% set selectedSubnavItem = 'coupons' %}
{% set fullPageForm = true %}

{% block content %}
    <input type="hidden" name="action" value="headcount/coupons/save">
    {% if not isNew %}
        <input type="hidden" name="couponId" value="{{ coupon.id }}">
    {% endif %}
    {{ csrfInput() }}
    {{ redirectInput('headcount/coupons/{id}') }}

    {{ forms.textField({
        first: true,
        label: 'Code'|t('headcount'),
        instructions: 'The coupon code users will enter at checkout.'|t('headcount'),
        name: 'code',
        value: coupon.code,
        required: true,
    }) }}

    {{ forms.textField({
        label: 'Description'|t('headcount'),
        name: 'description',
        value: coupon.description,
    }) }}

    {{ forms.selectField({
        label: 'Discount Type'|t('headcount'),
        name: 'discountType',
        value: coupon.discountType ?? 'percent',
        options: [
            { label: 'Percentage', value: 'percent' },
            { label: 'Flat Amount', value: 'flat' },
        ],
    }) }}

    {{ forms.textField({
        label: 'Discount Amount'|t('headcount'),
        instructions: 'Percentage (e.g., 20 for 20%) or flat amount.'|t('headcount'),
        name: 'discountAmount',
        value: coupon.discountAmount,
        type: 'number',
        step: '0.01',
        min: 0,
        required: true,
    }) }}

    {{ forms.checkboxSelectField({
        label: 'Applicable Plans'|t('headcount'),
        instructions: 'Leave empty to apply to all plans.'|t('headcount'),
        name: 'planIds',
        values: coupon.planIds ? (coupon.planIds is iterable ? coupon.planIds : coupon.planIds|json_decode) : [],
        options: planOptions,
    }) }}

    {{ forms.textField({
        label: 'Max Uses'|t('headcount'),
        instructions: 'Leave blank for unlimited.'|t('headcount'),
        name: 'maxUses',
        value: coupon.maxUses,
        type: 'number',
        min: 1,
    }) }}

    {{ forms.dateTimeField({
        label: 'Expires At'|t('headcount'),
        instructions: 'Leave blank for no expiration.'|t('headcount'),
        name: 'expiresAt',
        value: coupon.expiresAt,
    }) }}

    {{ forms.lightswitchField({
        label: 'Enabled'|t('headcount'),
        name: 'enabled',
        on: coupon.enabled ?? true,
    }) }}
{% endblock %}
